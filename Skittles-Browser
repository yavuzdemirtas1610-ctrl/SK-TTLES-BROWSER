import sys
import os
import time
import urllib.request
import urllib.parse
import re

def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')

def show_header():
    print("\n" + "=" * 40)
    print("\033[1;31m   #####  #    #     #  #####  #####  #      #####   ##### \033[0m")
    print("\033[1;33m  #       #   #      #    #      #    #      #      #      \033[0m")
    print("\033[1;32m   #####  ####       #    #      #    #      #      #####  ##### \033[0m")
    print("\033[1;36m        # #   #      #    #      #    #      #            #\033[0m")
    print("\033[1;35m  #####   #    #     #    #      #    ###### #####   ##### \033[0m")
    print("=" * 40 + "\n")

# --- YAVAŞ VE AKICI YÜKLEME EKRANI ---
def loading_screen():
    clear_screen()
    show_header()
    print("\033[1;36m[*] SKİTTLES Tarayıcı Çekirdeği Başlatılıyor...\033[0m\n")
    
    total_bars = 25
    for i in range(total_bars + 1):
        percent = int((i / total_bars) * 100)
        bar = "█" * i + "-" * (total_bars - i)
        sys.stdout.write(f"\r\033[1;32m[{bar}] %{percent}\033[0m")
        sys.stdout.flush()
        time.sleep(0.1) # Yükleme ekranı artık daha yavaş ve estetik
    
    print("\n\n\033[1;33m[✓] Tarayıcı Hazır!\033[0m")
    time.sleep(0.8)

# --- YAZI YAZMA EFEKTİ (TEK TEKER AKARAK YAZDIRMA) ---
def typewriter_print(text, speed=0.015, color="\033[0m"):
    sys.stdout.write(color)
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(speed)
    sys.stdout.write("\033[0m")

# --- İNTERAKTİF TARAYICI VE ARAMA MOTORU ---
def termux_browser():
    clear_screen()
    show_header()
    print("\033[1;35m=== [ SKİTTLES WEB BROWSER ] ===\033[0m\n")
    
    query = input("\033[1;33mGoogle'da veya Web'de ne aratmak istiyorsun? : \033[0m").strip()
    if not query:
        return

    print()
    typewriter_print(f"[*] '{query}' için web taranıyor ve sonuçlar derleniyor...\n", 0.02, "\033[1;34m")
    time.sleep(0.5)

    results = []
    try:
        search_url = "https://lite.duckduckgo.com/lite/"
        data = urllib.parse.urlencode({'q': query}).encode('utf-8')
        req = urllib.request.Request(search_url, data=data, headers={'User-Agent': 'Mozilla/5.0'})
        
        with urllib.request.urlopen(req, timeout=6) as response:
            html = response.read().decode('utf-8', errors='ignore')
            matches = re.findall(r'<a rel="nofollow" class="result-link" href="([^"]+)">([^<]+)</a>', html)
            
            for link, title in matches[:6]:
                results.append({"title": title.strip(), "link": link})
    except Exception:
        pass

    if not results:
        results = [
            {"title": f"{query.capitalize()} - Resmi Web Sayfası", "link": f"https://www.google.com/search?q={query}"},
            {"title": f"Wikipedia: {query} hakkında detaylı bilgi", "link": f"https://tr.wikipedia.org/wiki/{query}"},
            {"title": f"GitHub üzerinde {query} projeleri", "link": f"https://github.com/search?q={query}"},
            {"title": f"YouTube video sonuçları: {query}", "link": f"https://www.youtube.com/results?search_query={query}"},
            {"title": f"StackOverflow tartışmaları ({query})", "link": f"https://stackoverflow.com/search?q={query}"}
        ]

    print()
    typewriter_print(f"--- '{query}' İÇİN BULUNAN SONUÇLAR ---\n\n", 0.02, "\033[1;36m")

    # Sonuçları sırayla, teker teker, yazılıyormuş efektiyle alt alta yazdır
    for idx, res in enumerate(results, 1):
        line1 = f"  [{idx}] {res['title']}\n"
        line2 = f"      URL: {res['link']}\n\n"
        
        typewriter_print(line1, 0.01, "\033[1;32m")
        typewriter_print(line2, 0.005, "\033[1;30m")
        time.sleep(0.2) # Her sonuç arasında minik bir bekleme

    choice = input("\033[1;33mGitmek istediğin sonucun numarasını seç (1-%d) veya ana menü için 0: \033[0m" % len(results)).strip()
    
    try:
        choice_idx = int(choice)
        if choice_idx == 0:
            return
        elif 1 <= choice_idx <= len(results):
            selected = results[choice_idx - 1]
            target_url = selected['link']
            
            print()
            typewriter_print(f"[+] Seçilen Siteye Yönlendiriliyor: {selected['title']}\n", 0.02, "\033[1;32m")
            typewriter_print(f"[+] Adres: {target_url}\n", 0.02, "\033[1;36m")
            time.sleep(1)
            
            os.system(f"termux-open-url '{target_url}'")
            print()
            typewriter_print("[i] Tarayıcı komutu gönderildi. Telefonunun tarayıcısı açılıyor...\n", 0.02, "\033[1;33m")
        else:
            print("\n\033[1;31m[-] Geçersiz numara seçtin!\033[0m")
    except ValueError:
        print("\n\033[1;31m[-] Lütfen geçerli bir rakam gir!\033[0m")

    input("\n\033[1;32mDevam etmek için Enter'a bas...\033[0m")

# --- ANA MENÜ ---
def main():
    loading_screen()
    
    while True:
        clear_screen()
        show_header()
        
        print("  \033[1;33m[1]\033[0m Web'de Ara & Sonuçları Akıt (Tarayıcı Modu)")
        print("  \033[1;31m[0]\033[0m Çıkış\n")
        
        choice = input("\033[1;32mskittles@browser:~# \033[0m").strip()
        
        if choice == '1':
            termux_browser()
        elif choice == '0':
            print("\n\033[1;31m[*] Tarayıcı kapatılıyor...\033[0m")
            sys.exit()
        else:
            print("\n\033[1;31m[-] Geçersiz komut!\033[0m")
            time.sleep(1)

if __name__ == "__main__":
    main()
